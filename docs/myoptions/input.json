[ "Input",
  {
    "name": "Touch Screen: XPT2046 (SPI)",
    "define": "TS_MODEL TS_MODEL_XPT2046",
    "pins": "TS_CS",
    "defines": [
      { "define": "TS_SPI", "type": "spi", "comment": "assign touchscreen to SPI Bus" }
    ],
    "lib_deps": "${library.xpt2046}"
  },
  {
    "name": "Touch Screen: GT911 (I2C)",
    "define": "TS_MODEL TS_MODEL_GT911",
    "pins": [ "TS_SDA", "TS_SCL", "TS_INT", "TS_RST" ],
    "lib_deps": "${library.tamc_gt911}"
  },
  {
    "name": "Touch Screen: FT6336 (I2C)",
    "define": "TS_MODEL TS_MODEL_FT6336",
    "pins": [ "TS_SDA", "TS_SCL", "TS_INT", "TS_RST" ],
    "build_src_filter": "+<libraries/FT6336_Touchscreen/*>"
  },
  {
    "name": "Rotary Encoder",
    "info": "If the encoder works in the opposite expected direction, swap CLK and DT\nA is usually CLK, B is usually DT\nKY-040 2 steps / EC11 4 steps",
    "pins": [ "ENC_CLK", "ENC_DT", "ENC_SW" ],
    "defines": [
      { "define": "ENC_STEPS", "type": "enum", "options": ["1", "2", "4"], "default": "2", "optional": true, "comment": "rotary encoder steps (default 2)" },
      { "define": "ENC_PULLUP", "type": "boolean", "default": true, "comment": "use internal pullup on rotary (default true)" },
      { "define": "ENC_SW_PULLUP", "type": "boolean", "default": true, "comment": "use internal pullup on button (default true)" }
    ],
    "lib_deps": "${library.rotaryencoder}"
  },
  {
    "name": "Rotary Encoder 2",
    "info": "If the encoder works in the opposite expected direction, swap CLK and DT\nA is usually CLK, B is usually DT\nKY-040 2 steps / EC11 4 steps",
    "pins": [ "ENC2_CLK", "ENC2_DT", "ENC2_SW" ],
    "defines": [
      { "define": "ENC2_STEPS", "type": "enum", "options": ["1", "2", "4"], "default": "2", "optional": true, "comment": "rotary encoder steps (default 2)" },
      { "define": "ENC2_PULLUP", "type": "boolean", "default": true, "comment": "use internal pullup on rotary (default true)" },
      { "define": "ENC2_SW_PULLUP", "type": "boolean", "default": true, "comment": "use internal pullup on button (default true)" }
    ],
    "lib_deps": "${library.rotaryencoder}"
  },
  {
    "name": "Button: Play/Pause",
    "pins": [ "BTN_PLAY" ],
    "defines": [
      { "define": "BTN_PLAY_PULLUP", "type": "boolean", "default": true, "comment": "use internal pullup on button (default true)" }
    ],
    "lib_deps": "${library.onebutton}"
  },
  {
    "name": "Button: Previous Station/Track",
    "pins": [ "BTN_PREV" ],
    "defines": [
      { "define": "BTN_PREV_PULLUP", "type": "boolean", "default": true, "comment": "use internal pullup on button (default true)" }
    ],
    "lib_deps": "${library.onebutton}"
  },
  {
    "name": "Button: Next Station/Track",
    "pins": [ "BTN_NEXT" ],
    "defines": [
      { "define": "BTN_NEXT_PULLUP", "type": "boolean", "default": true, "comment": "use internal pullup on button (default true)" }
    ],
    "lib_deps": "${library.onebutton}"
  },
  {
    "name": "Button: Volume Up",
    "pins": [ "BTN_UP" ],
    "defines": [
      { "define": "BTN_UP_PULLUP", "type": "boolean", "default": true, "comment": "use internal pullup on button (default true)" }
    ],
    "lib_deps": "${library.onebutton}"
  },
  {
    "name": "Button: Volume Down",
    "pins": [ "BTN_DOWN" ],
    "defines": [
      { "define": "BTN_DOWN_PULLUP", "type": "boolean", "default": true, "comment": "use internal pullup on button (default true)" }
    ],
    "lib_deps": "${library.onebutton}"
  },
  {
    "name": "Button: Mode Switch",
    "pins": [ "BTN_MODE" ],
    "defines": [
      { "define": "BTN_MODE_PULLUP", "type": "boolean", "default": true, "comment": "use internal pullup on button (default true)" }
    ],
    "lib_deps": "${library.onebutton}"
  },
  {
    "name": "Wake Pin",
    "pins": [ "WAKE_PIN" ],
    "info": "The button on this pin can wake the device from deep sleep (re-use a button)",
    "lib_deps": "${library.onebutton}"
  }
]