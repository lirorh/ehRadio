[ { "title": "Peripherals and Build Options",
    "info": "Other hardware of the build." },
  {
    "name": "LED",
    "pins": [ "LED_PIN" ],
    "defines": [
      { "define": "LED_INVERT", "type": "boolean", "default": false, "comment": "inverted LED behavior" }
    ]
  },
  {
    "name": "RGB LED",
    "pins": [ "RGB_LED_PIN" ],
    "defines": [
      { "define": "RGB_LED_ORDER", "type": "enum", "options": ["NEO_GRB", "NEO_RGB", "NEO_RGBW"], "default": "NEO_GRB", "optional": true, "comment": "type of pixel (usually NEO_GRB) see https://learn.adafruit.com/adafruit-neopixel-uberguide/arduino-library-use" }
    ],
    "lib_deps": "${library.neopixel}"
  },
  {
    "name": "MQTT Enable",
    "define": "MQTT_ENABLE", "type": "flag", "optional": false, "comment": "enable MQTT",
    "info": "This must be checked to enable MQTT"
  },
  {
    "name": "IR Receiver",
    "pins": [ "IR_PIN" ],
    "defines": [
      { "define": "IR_TIMEOUT", "type": "numeric", "default": 80, "comment": "kTimeout, see IRremoteESP8266 documentation" }
    ],
    "lib_deps": "${library.irremote}"
  },
  {
    "name": "Real-Time Clock",
    "type": "I2C",
    "pins": [ "RTC_SDA", "RTC_SCL" ],
    "defines": [
      { "define": "RTC_MODULE", "type": "enum", "options": ["DS3231", "DS1307"], "optional": false }
    ],
    "lib_deps": "${library.rtclib}"
  },
  {
    "name": "SD Card Reader",
    "pins": [ "SD_CS" ],
    "defines": [
      { "define": "SD_SPI", "type": "spi", "comment": "assign SD to SPI bus" },
      { "define": "SD_CARD_DETECT_PIN", "type": "numeric", "default": 255, "min": 0, "max": 255, "optional": true, "comment": "Pin DETECT is attached to (255 for unused)"},
      { "define": "SD_AUTOPLAY", "type": "boolean", "default": false, "comment": "auto-switch to SD card mode when card is inserted (requires SD_CARD_DETECT_PIN != 255)" }
    ]
  }
]